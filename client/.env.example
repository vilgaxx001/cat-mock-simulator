# Local development: leave this unset. Vite's dev server proxies /api/* to
# the backend (see vite.config.ts), so relative paths just work.
#
# Production (e.g. Vercel): set this to your deployed backend's origin, with
# no trailing slash — e.g. https://cat-mock-simulator-api.onrender.com
VITE_API_BASE_URL=
