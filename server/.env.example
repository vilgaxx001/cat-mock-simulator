# Local development: leave both unset. Defaults are PORT=4000 and CORS open
# to any origin (fine locally — there's nothing sensitive to protect).

# Port the server listens on. Render sets this automatically — you don't
# need to set it yourself when deploying there.
PORT=4000

# Comma-separated list of origins allowed to call this API. Set this in
# production to your deployed frontend's exact origin(s), e.g.:
# CORS_ORIGIN=https://cat-mock-simulator.vercel.app
# Leave unset locally, or the dev server's proxy calls will be blocked.
CORS_ORIGIN=
